<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="exam.view.Controller">
   <children>
      <GridPane prefHeight="400.0" prefWidth="601.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints maxHeight="194.79999389648438" minHeight="10.0" prefHeight="73.19998779296876" vgrow="SOMETIMES" />
          <RowConstraints maxHeight="342.00000228881834" minHeight="10.0" prefHeight="327.6000122070312" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <TextArea prefHeight="350.0" prefWidth="550.0" GridPane.rowIndex="1" />
            <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Button fx:id="btnShowInventory" mnemonicParsing="false" onAction="#btnShowInventoryOnClick" text="Show Inventory" />
                  <Button fx:id="btnSort" mnemonicParsing="false" onAction="#btnSortOnClick" text="Sort" />
                  <Button fx:id="btnFindAverage" mnemonicParsing="false" onAction="#btnFindAverageOnClick" text="Find Average" />
                  <Button fx:id="btnGroup" mnemonicParsing="false" onAction="#btnGroupOnClick" text="Group" />
                  <Button fx:id="btnQuit" mnemonicParsing="false" onAction="#btnQuitOnClick" text="Quit" />
               </children>
            </HBox>
         </children>
      </GridPane>
   </children>
</AnchorPane>
